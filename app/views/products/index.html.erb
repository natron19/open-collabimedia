<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Products</h1>
  <%= link_to "New product", new_product_path, class: "btn btn-primary" %>
</div>

<% if @products.any? %>
  <div class="table-responsive">
    <table class="table table-dark table-hover table-bordered align-middle">
      <thead>
        <tr>
          <th>Name</th>
          <th>Goal</th>
          <th>Packages</th>
          <th>Last updated</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td>
              <%= link_to product.name, product_path(product), class: "fw-semibold text-decoration-none" %>
            </td>
            <td>
              <% goal_class = { "awareness" => "bg-primary", "engagement" => "bg-success", "conversion" => "bg-warning text-dark" }[product.content_goal] %>
              <span class="badge <%= goal_class %>"><%= product.content_goal.capitalize %></span>
            </td>
            <td><%= product.content_packages.count %></td>
            <td class="text-muted small"><%= product.updated_at.strftime("%b %-d, %Y") %></td>
            <td class="text-end">
              <%= link_to "Show", product_path(product), class: "btn btn-sm btn-outline-secondary me-1" %>
              <%= link_to "Edit", edit_product_path(product), class: "btn btn-sm btn-outline-secondary me-1" %>
              <%= link_to "Delete", product_path(product),
                    data: { turbo_method: :delete, turbo_confirm: "Delete #{product.name} and all its content packages?" },
                    class: "btn btn-sm btn-outline-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card bg-dark border-secondary">
    <div class="card-body text-center py-5">
      <i class="bi bi-box display-4 mb-3 d-block text-muted"></i>
      <h5 class="mb-2">No products yet</h5>
      <p class="text-muted mb-4">Add your first product to start generating social content packages.</p>
      <%= link_to "Create your first product", new_product_path, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
